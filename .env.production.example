APP_NAME=Msabagabo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ssabagabo.unihubug.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=unihubug_msabagabo_db
DB_USERNAME=unihubug_admin
DB_PASSWORD=SET_THIS_ONLY_ON_THE_SERVER

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ssabagabo.unihubug.com"
MAIL_FROM_NAME="${APP_NAME}"

